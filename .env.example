# ===========================================
# 环境变量配置示例
# ===========================================
# 部署到 Vercel 时，需要将这些变量配置到 Vercel 的环境变量中

# ===========================================
# Supabase 配置
# ===========================================
# Supabase 项目 URL（从 Supabase 控制台获取）
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key（从 Supabase 控制台获取）
# ⚠️ 这是敏感信息，请勿泄露
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ===========================================
# 豆包大模型 API 配置
# ===========================================
# 豆包 API 密钥（从豆包开放平台获取）
DOUBAO_API_KEY=your-doubao-api-key-here

# ===========================================
# 可选配置
# ===========================================

# 支付二维码配置（如果使用收款吧或旺铺管家）
SKOUFA_PAY_CODE=https://your-pay-code-url.com

# 管理员配置
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password-here

# ===========================================
# 部署说明
# ===========================================
# 1. 在 Vercel 项目设置中添加以上环境变量
# 2. 敏感变量（API 密钥）应该使用 "Secret" 类型
# 3. 修改 .env.example 后，不要将真实值提交到 Git
# 4. 生产环境应该使用强密码和定期更换 API 密钥
